generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SYS_ADMIN
  CLIENT_PM
  VENDOR_LEAD
  VENDOR_AM
  DEVELOPER
}

enum OvertimeStatus {
  PENDING
  APPROVED_CLIENT
  REJECTED_CLIENT
}

enum LeaveType {
  ANNUAL_LEAVE
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CoverageStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReplacementStatus {
  OPEN
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum ScopeSwapStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum IntegrationProvider {
  EMAIL
  SMTP
  JIRA
  SERVICENOW
}

enum IntegrationTestStatus {
  NEVER
  SUCCESS
  FAILED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum TrainingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CoachingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PerformanceActionType {
  REWARD
  PUNISHMENT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
}

model Client {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  isActive    Boolean      @default(true)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  developers  Developer[]
  projects    Project[]
  evaluations MonthlyEvaluation[]
  scopeSwaps  ScopeSwap[]
  replacements ReplacementTicket[]
  coverages   CoverageAssignment[]
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String
  passwordHash   String?
  role           Role
  clientId       String?
  client         Client?    @relation(fields: [clientId], references: [id])
  isActive       Boolean    @default(true)
  developer      Developer?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  accounts       Account[]
  sessions       Session[]
  evaluationsAsPm MonthlyEvaluation[] @relation("EvaluatedBy")
  scopeSwapsRequested ScopeSwap[] @relation("ScopeSwapRequester")
  notifications  Notification[]
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  type      NotificationType @default(INFO)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Developer {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client              @relation(fields: [clientId], references: [id])
  hourlyRate       Decimal             @db.Decimal(10, 2)
  standardCapacity Decimal             @default(40) @db.Decimal(5, 2)
  jobTitle         String              @default("Developer")
  jiraAccountEmail String?             @unique
  jiraAccountId    String?
  jiraLinkedAt     DateTime?
  startDate        DateTime?           @db.Date
  endDate          DateTime?           @db.Date
  notes            String?
  skillTags        String[]
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  timesheets       Timesheet[]
  overtimeRequests OvertimeRequest[]
  leaveRequests    LeaveRequest[]
  developerSkills  DeveloperSkill[]
  trainings        Training[]
  coachings        Coaching[]
  performanceActions PerformanceAction[]
  evaluations      MonthlyEvaluation[]
  replacementsAsOutgoing ReplacementTicket[] @relation("OutgoingDeveloper")
  replacementsAsIncoming ReplacementTicket[] @relation("IncomingDeveloper")
  scopeSwapsIn     ScopeSwap[]         @relation("ScopeSwapIn")
  scopeSwapsOut    ScopeSwap[]         @relation("ScopeSwapOut")
  coveragesAsAbsent CoverageAssignment[] @relation("CoverageAbsent")
  coveragesAsCover  CoverageAssignment[] @relation("CoverageCover")
}

model Project {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  name        String
  code        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  timesheets  Timesheet[]
  scopeSwaps  ScopeSwap[]
  coverages   CoverageAssignment[]

  @@unique([clientId, code])
}

model Timesheet {
  id           String   @id @default(cuid())
  developerId  String
  developer    Developer @relation(fields: [developerId], references: [id])
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  workDate     DateTime @db.Date
  hours        Decimal  @db.Decimal(4, 2)
  taskSummary  String
  isOvertime   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([developerId, workDate])
  @@index([workDate])
}

model OvertimeRequest {
  id           String         @id @default(cuid())
  developerId  String
  developer    Developer      @relation(fields: [developerId], references: [id])
  workDate     DateTime       @db.Date
  requestedHours Decimal      @db.Decimal(4, 2)
  reason       String
  status       OvertimeStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([developerId, status])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  developerId   String
  developer     Developer   @relation(fields: [developerId], references: [id])
  leaveType     LeaveType
  status        LeaveStatus @default(PENDING)
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  totalDays     Decimal     @db.Decimal(4, 1)
  reason        String
  reviewNote    String?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  coverages     CoverageAssignment[]

  @@index([developerId, status])
  @@index([startDate, endDate])
}

model CoverageAssignment {
  id              String         @id @default(cuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id])
  leaveRequestId  String?
  leaveRequest    LeaveRequest?  @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  absentDeveloperId String
  absentDeveloper Developer      @relation("CoverageAbsent", fields: [absentDeveloperId], references: [id])
  coverDeveloperId  String
  coverDeveloper  Developer      @relation("CoverageCover", fields: [coverDeveloperId], references: [id])
  status          CoverageStatus @default(PLANNED)
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  reason          String
  notes           String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([clientId, status])
  @@index([absentDeveloperId, startDate, endDate])
  @@index([coverDeveloperId, startDate, endDate])
  @@index([projectId])
}

model MonthlyEvaluation {
  id            String   @id @default(cuid())
  developerId   String
  developer     Developer @relation(fields: [developerId], references: [id])
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  evaluatedById String
  evaluatedBy   User     @relation("EvaluatedBy", fields: [evaluatedById], references: [id])
  year          Int
  month         Int
  codeQuality   Decimal  @db.Decimal(3, 2)
  delivery      Decimal  @db.Decimal(3, 2)
  technical     Decimal  @db.Decimal(3, 2)
  communication Decimal  @db.Decimal(3, 2)
  professionalism Decimal @db.Decimal(3, 2)
  totalScore    Decimal  @db.Decimal(4, 2)
  comments      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  replacementTicket ReplacementTicket?

  @@unique([developerId, year, month])
  @@index([clientId, year, month])
}

model ReplacementTicket {
  id                   String            @id @default(cuid())
  evaluationId         String            @unique
  evaluation           MonthlyEvaluation @relation(fields: [evaluationId], references: [id])
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id])
  outgoingDeveloperId  String
  outgoingDeveloper    Developer         @relation("OutgoingDeveloper", fields: [outgoingDeveloperId], references: [id])
  incomingDeveloperId  String?
  incomingDeveloper    Developer?        @relation("IncomingDeveloper", fields: [incomingDeveloperId], references: [id])
  status               ReplacementStatus @default(OPEN)
  slaTargetDays        Int               @default(10)
  slaDueDate           DateTime
  triggerScore         Decimal           @db.Decimal(4, 2)
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([status, slaDueDate])
}

model ScopeSwap {
  id                 String          @id @default(cuid())
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id])
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id])
  requestedById      String
  requestedBy        User            @relation("ScopeSwapRequester", fields: [requestedById], references: [id])
  outDeveloperId     String
  outDeveloper       Developer       @relation("ScopeSwapOut", fields: [outDeveloperId], references: [id])
  inDeveloperId      String
  inDeveloper        Developer       @relation("ScopeSwapIn", fields: [inDeveloperId], references: [id])
  outStoryPoints     Decimal         @db.Decimal(6, 2)
  inStoryPoints      Decimal         @db.Decimal(6, 2)
  outHours           Decimal         @db.Decimal(6, 2)
  inHours            Decimal         @db.Decimal(6, 2)
  outTaskDescription String
  inTaskDescription  String
  status             ScopeSwapStatus @default(PENDING)
  rationale          String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([clientId, status])
}

model IntegrationConfig {
  id              String                @id @default(cuid())
  provider        IntegrationProvider   @unique
  enabled         Boolean               @default(false)
  displayName     String
  description     String
  config          Json
  lastTestedAt    DateTime?
  lastTestStatus  IntegrationTestStatus @default(NEVER)
  lastTestMessage String?
  updatedById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model SkillCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills    Skill[]
}

model Skill {
  id          String           @id @default(cuid())
  name        String
  categoryId  String
  category    SkillCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  developers  DeveloperSkill[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model DeveloperSkill {
  id          String     @id @default(cuid())
  developerId String
  developer   Developer  @relation(fields: [developerId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level       SkillLevel @default(INTERMEDIATE)
  yearsExp    Decimal?   @db.Decimal(4, 1)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([developerId, skillId])
  @@index([skillId])
}

model Training {
  id          String         @id @default(cuid())
  developerId String
  developer   Developer      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  title       String
  provider    String
  status      TrainingStatus @default(PLANNED)
  startDate   DateTime       @db.Date
  endDate     DateTime?      @db.Date
  hours       Decimal        @db.Decimal(5, 1)
  skillFocus  String?
  location    String?
  notes       String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([developerId, status])
  @@index([startDate])
}

model Coaching {
  id          String         @id @default(cuid())
  developerId String
  developer   Developer      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  coachName   String
  topic       String
  status      CoachingStatus @default(SCHEDULED)
  sessionDate DateTime       @db.Date
  durationMin Int            @default(60)
  outcome     String?
  notes       String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([developerId, status])
}

model PerformanceAction {
  id          String                @id @default(cuid())
  developerId String
  developer   Developer             @relation(fields: [developerId], references: [id], onDelete: Cascade)
  actionType  PerformanceActionType
  title       String
  reason      String
  points      Int                   @default(0)
  actionDate  DateTime              @db.Date
  issuedById  String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([developerId, actionType])
  @@index([actionDate])
}
