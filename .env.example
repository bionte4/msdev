# Local development — PostgreSQL via docker compose
DATABASE_URL="postgresql://msdev:msdev@localhost:5435/outsourcing_db"
DIRECT_URL="postgresql://msdev:msdev@localhost:5435/outsourcing_db"

# Auth (local)
NEXTAUTH_SECRET="dev-secret-local-only"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
MAX_WEEKLY_HOURS_HARD_CAP="50"
MAX_DAILY_HOURS="16"
WEEKLY_HOURS_WARNING="45"
EVALUATION_REPLACEMENT_THRESHOLD="2.80"
REPLACEMENT_SLA_WORKING_DAYS="10"

# Jira live verify (Personnel link + Integrations test).
# Set to "true" only for local demos without a real Atlassian site.
# JIRA_SKIP_VERIFY="false"

# Scheduled Jira → portal pull (per Client Jira company, every 15 min by default).
# In-process scheduler (single node). Set true to enable with Next.js instrumentation.
JIRA_PULL_SCHEDULER="true"
# JIRA_PULL_INTERVAL_MS="900000"
# External cron: curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/jira-pull
CRON_SECRET="dev-cron-secret-change-me"
